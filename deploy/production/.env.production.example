# Ops in production: /opt/ops-prod/.env.production on the VPS.
#
# Copy this file there, fill it in, and keep it on the server only — it never
# goes into the repository (hard rule 3).
#
# **Every switch is off on the first deploy** (15, Phase 8 step 17): nothing
# sends, nothing writes to TA, nobody is mailed. The import migrations are run
# after their dry runs, the team walks the real screens with the switches
# still off, and then they are turned on one at a time, in this order:
#
#   1. OPS_MAIL_READ=on          - the reader starts filing replies
#   2. OPS_TA_READS_ENABLED=on and OPS_TA_FAKE=off  - real TA data
#   3. OPS_TA_WRITES_ENABLED=on  - Ops may write to TA (and the ops lead's own
#                                  switch.taWritesEnabled in Settings as well)
#   4. OPS_SEND=on with OPS_OUTBOUND_LOCK=on and the pilot client's addresses
#      in the allow list - the pilot (step 18)
#   5. OPS_OUTREACH_LIVE=on and the lock off - everybody (step 19)
#
# Each step is the owner's, one at a time, with a day between them.
#
# After changing anything here:  docker compose -f /opt/ops-prod/docker-compose.yml up -d app

# ── Where the desk is kept ───────────────────────────────────────────────────
OPS_STORE=convex
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3330
# From the preview backend, once:
#   docker exec ops-prod-convex ./generate_admin_key.sh | tail -1
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ── Signing in ───────────────────────────────────────────────────────────────
# OFF in production: the pick-your-name page is for the laptop and the
# preview. Clerk is the door here, and with this off and no Clerk keys the
# app lets nobody in - which is the right failure.
OPS_DEV_SIGNIN=off
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Any long random string; openssl rand -hex 32
OPS_SESSION_SECRET=
# The same value the image was built with, so a page left open across a deploy
# still works. The deploy passes it; set it here to the same string.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Nothing leaves the building ──────────────────────────────────────────────
# Sending is off, so every approved message records as blocked with a reason.
OPS_SEND=off
# Not live outreach until step 5 above. Everything approved records as
# blocked, with the reason, until then.
OPS_OUTREACH_LIVE=
# The last guard: with the lock on, only these addresses and numbers can ever
# be written to, whatever the rest of the system decides. It stays on through
# the pilot, holding the pilot client's own addresses and nobody else's.
OPS_OUTBOUND_LOCK=on
OPS_OUTBOUND_ALLOW_EMAILS=
OPS_OUTBOUND_ALLOW_PHONES=
OPS_TEST_EMAIL=
OPS_COMMON_MAILBOX=

# ── Reading the mailboxes: off ───────────────────────────────────────────────
# Off for the first deploy, then step 1. The Graph app needs the mailboxes the
# desk already uses, which is the owner's to grant (Track C).
OPS_MAIL_READ=off
OPS_MAILBOXES=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OPS_OUR_DOMAINS=career141.com

# ── The window to the TA System: the stand-in ────────────────────────────────
# The TA side of the API does not exist yet (it is a TA-side pull request), so
# even production starts on the stand-in and every screen says so. Reads
# first, writes after a day of reading.
OPS_TA_FAKE=on
OPS_TA_READS_ENABLED=off
OPS_TA_WRITES_ENABLED=off
OPS_TA_BASE_URL=
OPS_TA_TOKEN=

# ── Files ────────────────────────────────────────────────────────────────────
# Ops keeps real documents in production, so its own R2 bucket (c141-ops) is
# filled in here - never TA's bucket. A signed agreement nobody can find a
# year later is the thing this prevents.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OPS_DATA_DIR=/app/.data

# ── The AI layer: off, and a key or not ──────────────────────────────────────
# One of these is enough. Judgment work (reading what a client meant, the ask
# box) goes to Anthropic when its key is here; the plain work (tidying a
# draft, dictation into fields, summaries) goes to DeepSeek, which is cheap.
# With neither, the layer is off and every screen says so - the desk works
# exactly as it does now.
#
# The layer also has its own switch in the Settings screen, off by default,
# and a daily budget in rupees. At the cap it stops rather than spending.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── The clocks, running on their own ─────────────────────────────────────────
# The scheduled pass knocks on /api/clock with this key. Any long random
# string, and with no key set nobody may ask at all.
OPS_CLOCK_KEY=

# The website lead form posts to /api/leads/website with this in the
# x-ops-lead-key header. Make one the same way as the clock key.
OPS_WEB_LEAD_KEY=
#
# The asking is done by the Convex backend's own cron, which is a separate
# place with its own environment. Set the same key there, and tell it where the
# app is — inside the compose network that is the service name, not 127.0.0.1,
# because each container's own loopback is its own:
#
#   npx convex env set OPS_CLOCK_KEY '<the same key>'
#   npx convex env set OPS_APP_URL http://app:3300
