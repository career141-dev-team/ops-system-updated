# The Ops preview's environment: /opt/ops-preview/.env.preview on the VPS.
#
# Copy this file there, fill it in, and keep it on the server only — it never
# goes into the repository (hard rule 3). Every switch that could reach a real
# client, a real candidate or the TA System's database is off here, and the
# preview holds invented data by decision, so nothing in it is real.
#
# After changing anything here:  docker compose up -d app

# ── Where the desk is kept ───────────────────────────────────────────────────
OPS_STORE=convex
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3320
# From the preview backend, once:
#   docker exec ops-preview-convex ./generate_admin_key.sh | tail -1
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ── Signing in ───────────────────────────────────────────────────────────────
# The simple pick-your-name page, which is why the whole site is behind a
# password at Caddy. Clerk replaces this before anything real is in here.
OPS_DEV_SIGNIN=on
# Any long random string; openssl rand -hex 32
OPS_SESSION_SECRET=
# The same value the image was built with, so a page left open across a deploy
# still works. The deploy passes it; set it here to the same string.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Nothing leaves the building ──────────────────────────────────────────────
# Sending is off, so every approved message records as blocked with a reason.
OPS_SEND=off
# Not live outreach, and never on the preview.
OPS_OUTREACH_LIVE=
# The last guard: with the lock on, only these addresses and numbers can ever
# be written to, whatever the rest of the system decides. Keep it on here.
OPS_OUTBOUND_LOCK=on
OPS_OUTBOUND_ALLOW_EMAILS=
OPS_OUTBOUND_ALLOW_PHONES=
OPS_TEST_EMAIL=
OPS_COMMON_MAILBOX=

# ── Reading the mailboxes: off ───────────────────────────────────────────────
# The preview must not read real client mail. Left off, the /mail screen says
# so plainly instead of showing an empty inbox that looks like no mail.
OPS_MAIL_READ=off
OPS_MAILBOXES=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OPS_OUR_DOMAINS=career141.com

# ── The window to the TA System: the stand-in ────────────────────────────────
# The TA side of the API does not exist yet, so the preview talks to recorded
# sample answers and every screen says so. When the real API is live, this goes
# off and the three below are filled in — reads first, writes still off.
OPS_TA_FAKE=on
OPS_TA_READS_ENABLED=off
OPS_TA_WRITES_ENABLED=off
OPS_TA_BASE_URL=
OPS_TA_TOKEN=

# ── Files ────────────────────────────────────────────────────────────────────
# Empty means a folder inside the container, which is what the preview wants:
# nothing it keeps can be confused with a real client's document. Its own R2
# bucket (c141-ops) comes with the pilot, never TA's bucket.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OPS_DATA_DIR=/app/.data

# ── The clocks, running on their own ─────────────────────────────────────────
# The scheduled pass knocks on /api/clock with this key. Any long random
# string, and with no key set nobody may ask at all.
OPS_CLOCK_KEY=

# The website lead form posts to /api/leads/website with this in the
# x-ops-lead-key header. Make one the same way as the clock key.
OPS_WEB_LEAD_KEY=
#
# The asking is done by the Convex backend's own cron, which is a separate
# place with its own environment. Set the same key there, and tell it where the
# app is — inside the compose network that is the service name, not 127.0.0.1,
# because each container's own loopback is its own:
#
#   npx convex env set OPS_CLOCK_KEY '<the same key>'
#   npx convex env set OPS_APP_URL http://app:3300
