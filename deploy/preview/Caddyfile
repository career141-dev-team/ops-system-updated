# The one block to add to the VPS's existing Caddyfile for the Ops preview.
#
# Add it beside the TA System's blocks and reload Caddy; nothing about TA's own
# sites changes. The DNS is already there: ops-preview.career141.com is an A
# record to 94.136.189.48, DNS only (2 Nov).
#
# The password is the point. While the preview holds test data and signs people
# in with the simple pick-your-name page, the only thing between it and the
# internet is this basic auth, so it goes in before the first deploy and not
# after. Make the hash on the server with:
#
#   docker run --rm caddy:2 caddy hash-password --plaintext '<the password>'
#
# and paste it below. The hash is not a secret in the way the password is, but
# it does not belong in the repository either: keep this file as the shape and
# the real one on the server.

ops-preview.career141.com {
	encode zstd gzip

	basic_auth {
		# One account for everybody who is shown the preview.
		ops <paste the bcrypt hash here>
	}

	# Nothing here should ever be indexed, whatever the password does.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	reverse_proxy 127.0.0.1:3322 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output file /var/log/caddy/ops-preview.log
		format json
	}
}

# The Convex dashboard for the preview backend stays off the internet. Reach it
# over SSH instead, which needs no second password to look after:
#
#   ssh -L 6892:127.0.0.1:6892 root@94.136.189.48
#   then http://127.0.0.1:6892 in a browser
