# Ops system, local development. Copy to .env.local and fill in.
# Never commit a real value. Nothing here points at anything live.

# Which store the app reads: json (invented sample data) or convex (local backend)
OPS_STORE=json

# Pick-your-name sign-in, for development only. Never on in production.
OPS_DEV_SIGNIN=on

# Signs the development session cookie. Any long random string locally.
OPS_SESSION_SECRET=

# The local Convex backend, written by deploy/local/start.sh
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# The mailboxes we read, comma separated. Shared boxes and people's own boxes
# are the same kind of thing here. Nothing is read until OPS_MAIL_READ is on,
# and Microsoft must allow the app to read each one.
OPS_MAILBOXES=
OPS_MAIL_READ=off
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The window to the TA System. Reads only, and off until the API exists.
OPS_TA_READS_ENABLED=off
OPS_TA_WRITES_ENABLED=off
OPS_TA_BASE_URL=
OPS_TA_TOKEN=

# Nothing reaches a client or a candidate while this is off. Never set it here.
OPS_OUTREACH_LIVE=
OPS_TEST_EMAIL=

OPS_OUR_DOMAINS=career141.com

# Sending. Off everywhere until somebody says otherwise; the screens say "switched off"
# rather than pretending a message went.
OPS_SEND=off

# The last guard under the senders: with the lock on, only these addresses and numbers
# can be written to, whatever the rest of the system decides. Set it on every machine
# and on the preview - the database will one day hold real client contacts.
OPS_OUTBOUND_LOCK=on
OPS_OUTBOUND_ALLOW_EMAILS=
OPS_OUTBOUND_ALLOW_PHONES=

# Where a message goes while outreach is in test mode.
OPS_TEST_EMAIL=

# Copied on every client email, so a thread is never one person's alone.
OPS_COMMON_MAILBOX=

# The Ops WhatsApp number, from Meta.
OPS_WHATSAPP_NUMBER_ID=
OPS_WHATSAPP_TOKEN=
