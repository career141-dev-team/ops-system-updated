# Ops system, local development. Copy to .env.local and fill in.
# Never commit a real value. Nothing here points at anything live.

# Which store the app reads: json (invented sample data) or convex (local backend)
OPS_STORE=json

# Sign-in. Real sign-in uses Clerk (recommended) or Microsoft. When either is
# configured, development pick-your-name sign-in is automatically disabled.
# Clerk keys (from Clerk Dashboard or `npx -y clerk@latest env pull`):
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# Comma-separated emails of developers / higher-ups auto-provisioned as Admin on first Clerk sign-in:
OPS_ADMIN_EMAILS=

# Development sign-in (ignored whenever Clerk or Microsoft sign-in is configured):
OPS_DEV_SIGNIN=on

# Signs the session cookie, so a cookie somebody wrote themselves is not a
# session. Sixteen characters or more, or it counts as unset: openssl rand -hex 32.
OPS_SESSION_SECRET=

# Microsoft sign-in (the same tenant as the mail settings below). The app
# registration needs OPS_APP_URL + /sign-in/microsoft/back as a redirect URI,
# exactly as written. The ops team on the People screen is the allow-list: a
# real Microsoft account proves who somebody is, not that they work here.

# The local Convex backend, written by deploy/local/start.sh
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# The mailboxes we read, comma separated. Shared boxes and people's own boxes
# are the same kind of thing here. Nothing is read until OPS_MAIL_READ is on,
# and Microsoft must allow the app to read each one.
OPS_MAILBOXES=
# A Scoop (many CVs in one email) is read from one mailbox, from the people named here (addresses or whole
# domains, comma separated). Needs OPS_MAIL_READ=on. Can also be set in Settings; the setting wins.
OPS_SCOOP_MAILBOX=
OPS_SCOOP_SENDERS=
OPS_MAIL_READ=off
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The window to the TA System. Reads only, and off until the API exists.
OPS_TA_READS_ENABLED=off
OPS_TA_WRITES_ENABLED=off
OPS_TA_BASE_URL=
OPS_TA_TOKEN=

# Whether this machine may reach real people at all. Off (or unset) and every
# client message goes to OPS_TEST_EMAIL instead, whatever the database says.
# Both have to agree: this, and switch.outreachLive on the Settings screen. The
# setting travels with a restored backup; this does not, which is the point of
# having both. Never set it here.
OPS_OUTREACH_LIVE=
OPS_TEST_EMAIL=

OPS_OUR_DOMAINS=career141.com

# Sending. Off everywhere until somebody says otherwise; the screens say "switched off"
# rather than pretending a message went.
OPS_SEND=off

# The last guard under the senders: with the lock on, only these addresses and numbers
# can be written to, whatever the rest of the system decides. Set it on every machine
# and on the preview - the database will one day hold real client contacts.
OPS_OUTBOUND_LOCK=on
OPS_OUTBOUND_ALLOW_EMAILS=
OPS_OUTBOUND_ALLOW_PHONES=

# Where a message goes while outreach is in test mode.
OPS_TEST_EMAIL=

# Development only (when OPS_DEV_SIGNIN=on): real Microsoft 365 mailbox to send
# from on a laptop instead of the seeded `@example.test` member addresses.
# Ignored outside dev sign-in.
OPS_DEV_SENDER_EMAIL=

# Copied on every client email, so a thread is never one person's alone.
OPS_COMMON_MAILBOX=

# The Ops WhatsApp number, from Meta.
OPS_WHATSAPP_NUMBER_ID=
OPS_WHATSAPP_TOKEN=
# Inbound (23 Nov): Meta posts a message to /api/whatsapp. Nothing is accepted without the app secret.
OPS_WHATSAPP_APP_SECRET=
OPS_WHATSAPP_VERIFY_TOKEN=
# The id of the one WhatsApp group whose CV documents are read into the Scoop intake (25 Nov). Empty reads none.
OPS_WHATSAPP_CV_GROUP=

# The clocks run on their own: the Ops Convex deployment asks the app for a pass
# every five minutes. Both sides need the same long random key, and with no key
# set nothing may ask. On the Convex side set OPS_APP_URL as well, pointing at
# this app (never at anything live).
OPS_CLOCK_KEY=

# The key the website's contact form sends in the x-ops-lead-key header when it
# posts to /api/leads/website. With none set, nobody may post a lead.
OPS_WEB_LEAD_KEY=
OPS_APP_URL=

# Where files are kept. With these empty, files go to a folder beside the data
# on this machine, which is what the laptop and the test-data preview use. On
# the server they go to Cloudflare R2, and a download is a signed link that
# stops working after ten minutes. Nothing is ever public.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The AI layer. Either key switches it on, then switch.aiEnabled in Settings.
#
# DeepSeek has two doors and OpenRouter wins where both are set. The owner
# buys through OpenRouter, whose workspace guardrail allows exactly one
# DeepSeek model: asking for any other comes back 404 "Model blocked by
# guardrail", which reads like the model does not exist. OPENROUTER_MODEL
# corrects it without a deploy if that ever changes.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# LibreOffice turns a filled Word template into the PDF that goes to a client.
# Leave it empty where soffice is on the path; the screens say so plainly on a
# machine that has no LibreOffice.
SOFFICE_PATH=

# The window to the TA System. While OPS_TA_FAKE is on, a stand-in answers
# with recorded sample data and every screen says so. The real API exists now
# (ta-system, docs/OPS-SYSTEM-API.md): to use it, turn this off and set
# OPS_TA_BASE_URL, OPS_TA_TOKEN and OPS_TA_READS_ENABLED above.
#
# Writes need both sides to agree: OPS_TA_WRITES_ENABLED here and
# OPS_API_WRITES_ENABLED on the TA server, which also needs OPS_API_ACTOR_EMAIL
# naming the TA user every Ops-made change is recorded as. Either side off and
# a write waits in our outbox - nothing is ever lost, and nothing goes twice:
# every write carries an idempotency key the TA side keeps.
OPS_TA_FAKE=off
