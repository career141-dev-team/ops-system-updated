{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-system-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // The demo's settings, written here so nothing has to be typed into the dashboard to see the screens (17 Nov, the owner:
  // "only the UI and the UI flow for now"). None of them is a secret. When real sign-in is added later, set MS_TENANT_ID,
  // MS_CLIENT_ID, MS_CLIENT_SECRET, OPS_APP_URL and OPS_SESSION_SECRET as secrets in the dashboard: with those present the
  // app switches the "pick your name" door off by itself (src/lib/session.ts), whatever OPS_DEV_SIGNIN says.
  "vars": {
    "OPS_STORE": "convex",
    "CONVEX_SELF_HOSTED_URL": "https://savory-badger-711.convex.cloud",
    "OPS_APP_URL": "https://ops-system-demo.bytecreator3.workers.dev",
    "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
    "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
    "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/",
    "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/",
    "OPS_DATA_DIR": "/tmp/ops-data",
    "OPS_DEV_SIGNIN": "off",
    "OPS_TA_FAKE": "on",
    "OPS_TEAMS_FAKE": "on",
    "OPS_SEND": "off",
    "OPS_OUTBOUND_LOCK": "on"
  }
}
